# Application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/oauth2_server

# JWT Access Tokens
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_ACCESS_TOKEN_TTL=15m

# Refresh Tokens (opaque, stored hashed in DB - see docs/OAUTH_FLOW.md)
REFRESH_TOKEN_TTL_DAYS=30

# Authorization Codes
AUTH_CODE_TTL_SECONDS=60

# Cookies
REFRESH_TOKEN_COOKIE_NAME=refresh_token
COOKIE_DOMAIN=localhost

# CORS - comma separated list of allowed origins
# http://localhost:5173 is the Vite dev server for the oauth2-client demo frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
