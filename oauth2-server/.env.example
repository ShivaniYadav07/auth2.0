# Application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/oauth2_server

# JWT Access Tokens
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_ACCESS_TOKEN_TTL=15m

# Refresh Tokens (opaque, stored hashed in DB - see docs/OAUTH_FLOW.md)
REFRESH_TOKEN_TTL_DAYS=30

# Authorization Codes
AUTH_CODE_TTL_SECONDS=60

# Cookies
REFRESH_TOKEN_COOKIE_NAME=refresh_token
# Leave COOKIE_DOMAIN unset in production when the frontend and backend are on
# different hosts (e.g. Vercel + Render) - the cookie then binds to the backend host.
COOKIE_DOMAIN=localhost
# Use 'strict' for same-site (local/dev). Set to 'none' when the frontend is on a
# different site than the backend (Vercel <-> Render); 'none' requires HTTPS (secure).
COOKIE_SAMESITE=strict

# CORS - comma separated list of allowed origins
# http://localhost:5173 is the Vite dev server for the oauth2-client demo frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
