{
  "name": "oauth2-authorization-server",
  "version": "1.0.0",
  "description": "A production-inspired OAuth 2.0 Authorization Server implementing the Authorization Code Flow",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.js\""
  },
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.16.0",
    "@eslint/js": "^9.16.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
